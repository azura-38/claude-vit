# VitaCase Build Configuration
# Copy this file to build.env and fill in your values.
# Use with: flutter build apk --dart-define-from-file=build.env
#
# IMPORTANT: Never commit build.env to version control!

SENTRY_DSN=https://your-dsn@sentry.io/project-id
ADMOB_APP_ID=ca-app-pub-xxxxxxxx~xxxxxxxx
AD_BANNER_ID=ca-app-pub-xxxxxxxx/xxxxxxxx
AD_INTERSTITIAL_ID=ca-app-pub-xxxxxxxx/xxxxxxxx
AD_REWARDED_ID=ca-app-pub-xxxxxxxx/xxxxxxxx
